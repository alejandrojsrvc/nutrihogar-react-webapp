{
  "name": "nutrition-clients",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @nutrihogar/web",
    "build": "npm run build --workspace @nutrihogar/web",
    "lint": "npm run lint --workspace @nutrihogar/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace @nutrihogar/web"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=10.0.0"
  }
}
